{
  "id": "/",
  "name": "리코더 운지법 배우기",
  "short_name": "리코더 운지",
  "description": "낮은 계이름 8음, 높은 계이름 5음, 반음 5음(C4–G5)의 소프라노 리코더 운지를 실제 손 모양 포즈와 구멍 지도로 배우는 교육용 웹앱",
  "lang": "ko-KR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3f6fb",
  "theme_color": "#2858c7",
  "categories": ["education", "music"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "낮은 계이름 연습",
      "short_name": "낮은 음",
      "description": "낮은 도부터 높은 도까지 기본 운지를 연습합니다.",
      "url": "/?bank=low",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "높은 계이름 연습",
      "short_name": "높은 음",
      "description": "높은 도부터 높은 솔까지 운지를 연습합니다.",
      "url": "/?bank=high",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "반음 운지 연습",
      "short_name": "반음",
      "description": "도샵, 레샵, 파샵 등 반음 운지를 연습합니다.",
      "url": "/?bank=chromatic",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    { "src": "/screenshots/mobile.png", "sizes": "360x800", "type": "image/png", "form_factor": "narrow" },
    {
      "src": "/og-remastered.png",
      "sizes": "1730x909",
      "type": "image/png",
      "form_factor": "wide"
    }
  ]
